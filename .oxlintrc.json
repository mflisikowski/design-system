{
  "extends": ["./packages/lint-config/oxlint.json"],
  "categories": {
    "correctness": "error"
  },
  "plugins": ["import", "jsx-a11y", "react", "typescript", "unicorn"],
  "ignorePatterns": [
    "**/.next/**",
    "**/.turbo/**",
    "**/node_modules/**",
    "apps/docs/public/r/**",
    "coverage/**",
    "dist/**",
    "packages/lint-config/test/fixtures/**",
    "packages/tokens/test/fixtures/**",
    "apps/reference-crm/public/mockServiceWorker.js",
    "spikes/oxlint-shadcn-lint/**"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["registry/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "shadcn/no-restyle": "off"
      }
    }
  ]
}
