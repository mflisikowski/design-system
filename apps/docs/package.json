{
  "name": "@mflisikowski/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm docs:check && next build --webpack",
    "dev": "next dev --webpack",
    "docs:check": "vitest run lib",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test": "vitest run lib",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:release": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@mdx-js/loader": "catalog:",
    "@mdx-js/react": "catalog:",
    "@mflisikowski/tokens": "workspace:*",
    "@next/mdx": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "1.47.0",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@mflisikowski/typescript-config": "workspace:*",
    "@mflisikowski/registry-release": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
